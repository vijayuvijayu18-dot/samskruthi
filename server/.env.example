# ========================================================================
# SAMSKRUTHI POSTGRESQL & AUTH CONFIGURATION
# ========================================================================

# Server Port
PORT=5000

# Turso Cloud Database (libSQL AWS Mumbai)
TURSO_DATABASE_URL=libsql://samskruthi-uvijay.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# PostgreSQL Connection String (Alternative / fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/samskruthi_db

# JWT Secret for User Sessions
JWT_SECRET=samskruthi_heritage_secret_key_2026

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
